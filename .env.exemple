# Copier ce fichier en .env (jamais versionné) et renseigner vos valeurs.
# Charger les variables :  set -a; . ./.env; set +a

# Principal de service du lab (installation/01-identites-et-prerequis.md)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Coffre de clés (installation/05-coffre-de-cles.md), avec la barre oblique finale
COFFRE_URI=https://<coffre>.vault.azure.net/

# Site e-commerce (installation/02-site-ecommerce-nopcommerce.md)
AMAZINGZONE_SQL_SERVEUR=<serveur>.database.windows.net
AMAZINGZONE_SQL_BASE=amazingdb

# Point de terminaison SQL de l'espace Fabric (Lakehouse > SQL analytics endpoint > SQL connection string).
# Facultatif : seulement pour les générateurs lancés avec --geo lakehouse.
AMAZINGZONE_POINT_SQL_FABRIC=<xxxx>.datawarehouse.fabric.microsoft.com

# Espace Fabric de développement et Eventstream du WMS (installation/07-fabric-espaces-et-elements.md)
FABRIC_ESPACE_ID=
WMS_EVENTSTREAM_ID=
WMS_EVENTSTREAM_SOURCE_ID=

# Identifiants des connexions Fabric, lus par installation/deployer_fabric.py (parameter.yml)
CONNEXION_POSTGRESQL_WMS=
CONNEXION_COPYJOB_SP=
CONNEXION_PIPELINE_SP=
CONNEXION_DBT_SP=
CONNEXION_MODELE_SEMANTIQUE_SP=
CONNEXION_KEYVAULT_SP=
CONNEXION_EVENTHUB_JOURNAUX=
CONNEXION_SQL_NOPCOMMERCE_SP=
# Locataire SharePoint, sans https:// (ex. contoso.sharepoint.com)
SHAREPOINT_HOTE=
# Adresse qui reçoit les e-mails des Activator du chapitre 8
DESTINATAIRE_ALERTES=
# Espace « AmazingZone - Mirroring » et base mirrorée amazingdb (raccourcis ecommerce du Lakehouse)
FABRIC_ESPACE_MIRRORING_ID=
MIRRORING_AMAZINGDB_ID=

# Déploiement continu du chapitre 10, lu par deploiement/deployer.py (installation/11-industrialisation.md).
# Dans Azure DevOps, ces valeurs et celles des connexions ci-dessus sont des variables du pipeline.
# Espaces AmazingZone - Dev (intégration), AmazingZone - Test et AmazingZone - Prod
FABRIC_ESPACE_INTEGRATION_ID=
FABRIC_ESPACE_TEST_ID=
FABRIC_ESPACE_PROD_ID=
# Connexion « SharePoint - Finance (SP AmazingZone) », liée au modèle « Ventes et logistique » après chaque déploiement
CONNEXION_SHAREPOINT_FINANCE=
