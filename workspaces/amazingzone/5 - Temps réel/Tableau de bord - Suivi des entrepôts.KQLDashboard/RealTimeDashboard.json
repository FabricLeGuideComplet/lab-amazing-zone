  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "d5c522c7-9027-5029-bc0b-d5744743ee50"
      },
      "text": "wms_evenements\n| where DateEvenement between (_startTime .. _endTime) and CodeEntrepot in (_entrepots)\n| count",
      "id": "9a774e00-d3cf-5d27-9742-6e665998c00e",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_entrepots"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "d5c522c7-9027-5029-bc0b-d5744743ee50"
      },
      "text": "mv_DernierEvenementEntrepot\n| summarize Silencieux = countif(DateEvenement < ago(15m))",
      "id": "c3c4404f-24f7-58ec-959d-c95fd8315dc3",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "d5c522c7-9027-5029-bc0b-d5744743ee50"
      },
      "text": "mv_DernierEvenementEntrepot\n| extend SilenceMinutes = datetime_diff(\"minute\", now(), DateEvenement)\n| project CodeEntrepot, DernierEvenement = DateEvenement, TypeEvenement, SilenceMinutes\n| order by CodeEntrepot asc",
      "id": "4ee277dd-d9de-5c5e-a72c-572ef680985c",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "d5c522c7-9027-5029-bc0b-d5744743ee50"
      },
      "text": "wms_evenements\n| where DateEvenement between (_startTime .. _endTime) and CodeEntrepot in (_entrepots)\n| summarize Evenements = count() by CodeEntrepot\n| join kind = inner (external_table(\"dim_entrepot\") | project CodeEntrepot, Entrepot, Latitude, Longitude) on CodeEntrepot\n| project Entrepot, Latitude, Longitude, Evenements",
      "id": "6ab8a853-c482-5b8c-8928-0ea51f4465bf",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_entrepots"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "d5c522c7-9027-5029-bc0b-d5744743ee50"
      },
      "text": "wms_evenements\n| where DateEvenement between (_startTime .. _endTime) and CodeEntrepot in (_entrepots)\n| summarize Evenements = count() by bin(DateEvenement, 1m), TypeEvenement\n| order by DateEvenement asc",
      "id": "f2cad976-d09c-5f75-88b9-cf23db9a6a39",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_entrepots"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "d5c522c7-9027-5029-bc0b-d5744743ee50"
      },
      "text": "fn_StockTempsReel()\n| where CodeEntrepot in (_entrepots) and MouvementsDepuisPhoto != 0\n| project CodeEntrepot, Sku, StockPhoto, MouvementsDepuisPhoto, StockTempsReel, DernierMouvement\n| top 20 by abs(MouvementsDepuisPhoto)",
      "id": "45df3cf7-c361-5f28-b6e1-bc4d063cbed7",
      "usedVariables": [
        "_entrepots"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "d5c522c7-9027-5029-bc0b-d5744743ee50"
      },
      "text": "external_table(\"dim_entrepot\")\n| where CodeEntrepot != \"?\"\n| distinct CodeEntrepot\n| order by CodeEntrepot asc",
      "id": "7b7e585f-327f-592e-a3d9-820213c3dc9d",
      "usedVariables": []
    }
