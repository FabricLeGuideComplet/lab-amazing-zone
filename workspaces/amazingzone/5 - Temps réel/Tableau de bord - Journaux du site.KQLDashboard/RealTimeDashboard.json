  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3cbb603b-df05-511d-a908-40f779ace9e0"
      },
      "text": "fn_ParseWebLogs()\n| where Type == \"AppServiceHTTPLogs\" and dateLog between (_startTime .. _endTime)\n| count",
      "id": "2b53ae91-a3be-50db-8b32-717c8d70d98d",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3cbb603b-df05-511d-a908-40f779ace9e0"
      },
      "text": "fn_ParseWebLogs()\n| where Type == \"AppServiceHTTPLogs\" and dateLog between (_startTime .. _endTime)\n| summarize TauxErreur = round(100.0 * countif(Success == false) / count(), 1)",
      "id": "a0fe4279-132d-5535-9228-a45e18b34fb2",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3cbb603b-df05-511d-a908-40f779ace9e0"
      },
      "text": "fn_ParseWebLogs()\n| where Type == \"AppServiceHTTPLogs\"\n| summarize Minutes = datetime_diff(\"minute\", now(), max(dateLog))",
      "id": "9a765ada-9a5e-55e0-a17b-219d62e017b3",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3cbb603b-df05-511d-a908-40f779ace9e0"
      },
      "text": "fn_ParseWebLogs()\n| where Type == \"AppServiceHTTPLogs\" and dateLog between (_startTime .. _endTime)\n| summarize P95 = round(percentile(DurationMs, 95), 0)",
      "id": "d57e8c9a-3d56-51ef-9929-7c3edf0a89a7",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3cbb603b-df05-511d-a908-40f779ace9e0"
      },
      "text": "fn_ParseWebLogs()\n| where Type == \"AppServiceHTTPLogs\" and dateLog between (_startTime .. _endTime)\n| summarize Requetes = count(), Erreurs = countif(Success == false) by bin(dateLog, 1m)\n| order by dateLog asc",
      "id": "bc11b9ce-5f3c-5304-b1b8-b9ee95c433b3",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3cbb603b-df05-511d-a908-40f779ace9e0"
      },
      "text": "fn_ParseWebLogs()\n| where Type == \"AppServiceHTTPLogs\" and dateLog between (_startTime .. _endTime)\n| summarize Mediane = percentile(DurationMs, 50), P95 = percentile(DurationMs, 95) by bin(dateLog, 1m)\n| order by dateLog asc",
      "id": "324c3680-88e9-5ca8-a957-3ebb37411ab8",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3cbb603b-df05-511d-a908-40f779ace9e0"
      },
      "text": "fn_ParseWebLogs()\n| where Type == \"AppServiceHTTPLogs\" and dateLog between (_startTime .. _endTime)\n| summarize Requetes = count() by ResultCode\n| order by Requetes desc",
      "id": "6d4d24d3-3d4a-57d9-abc4-5af86a04468b",
