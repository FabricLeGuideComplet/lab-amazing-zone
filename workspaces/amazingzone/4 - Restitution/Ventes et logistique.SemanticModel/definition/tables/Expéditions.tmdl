/// Commandes logistiques du WMS, une ligne par commande : entrepôt de préparation, transporteur et délai entre la prise en charge et l'expédition. La relation active avec le calendrier porte sur la date d'expédition.
table Expéditions
	lineageTag: 090757c0-1949-5a80-9819-8c02c87f8cff
	sourceLineageTag: [gold].[FaitExpedition]

	/// Nombre de commandes expédiées, datées par leur jour d'expédition.
	measure 'Nombre d''expéditions' = CALCULATE(COUNTROWS('Expéditions'), NOT ISBLANK('Expéditions'[DateExpeditionId]))
		formatString: #,0
		lineageTag: 18425495-13c5-5d09-aec1-9421c0243157

	/// Nombre de commandes transmises au WMS, datées par leur jour de prise en charge.
	measure 'Commandes prises en charge' = CALCULATE(COUNTROWS('Expéditions'), USERELATIONSHIP('Expéditions'[DatePriseEnChargeId], Calendrier[DateId]))
		formatString: #,0
		lineageTag: ac767616-c6dd-5c72-907a-7224a92a9f18

	/// Nombre d'articles des commandes expédiées.
	measure 'Articles expédiés' = CALCULATE(SUM('Expéditions'[NbArticles]), NOT ISBLANK('Expéditions'[DateExpeditionId]))
		formatString: #,0
		lineageTag: 95838d52-fdca-5b33-92f0-cd98e236aa2d

	/// Délai moyen, en heures, entre la prise en charge par le WMS et l'expédition.
	measure 'Délai moyen de préparation (h)' = AVERAGE('Expéditions'[DelaiPreparationHeures])
		formatString: #,0.0
		lineageTag: a822b568-3c63-5950-8455-0baff3678c25

	/// Part des commandes expédiées moins de 24 heures après leur prise en charge.
	measure '% expédiées sous 24 h' = DIVIDE(CALCULATE(COUNTROWS('Expéditions'), 'Expéditions'[EstExpedieeSous24h] = TRUE()), [Nombre d'expéditions])
		formatString: 0.0 %
		lineageTag: f45f7e7a-e9c0-552f-af45-7f713287bfe0

	column NumeroCommande
		dataType: string
		isHidden
		lineageTag: 7be2cae6-c9c9-5aff-9156-6f3d20823976
		sourceLineageTag: NumeroCommande
		summarizeBy: none
		sourceColumn: NumeroCommande

