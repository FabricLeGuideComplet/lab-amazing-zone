/// Ventes du site e-commerce, une ligne par ligne de commande. Les commandes annulées sont exclues ; les montants sont hors taxes.
table Ventes
	lineageTag: 697a3da5-7bf6-5486-9bb8-3957fa503344
	sourceLineageTag: [gold].[FaitVente]

	/// Chiffre d'affaires hors taxes des commandes non annulées.
	measure 'CA HT' = SUM(Ventes[MontantHT])
		formatString: #,0 €
		displayFolder: Chiffre d'affaires
		lineageTag: e300048d-e2a9-5599-97b8-3d3d59a2be0c

	/// Chiffre d'affaires hors taxes de la même période l'année précédente.
	measure 'CA HT N-1' = CALCULATE([CA HT], SAMEPERIODLASTYEAR(Calendrier[Date]))
		formatString: #,0 €
		displayFolder: Chiffre d'affaires
		lineageTag: d29dbf5b-c7cd-5c20-b6fd-f0484d556c93

	/// Évolution du chiffre d'affaires hors taxes par rapport à la même période l'année précédente.
	measure 'Évolution CA HT' = IF(NOT ISBLANK([CA HT]), DIVIDE([CA HT] - [CA HT N-1], [CA HT N-1]))
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Chiffre d'affaires
		lineageTag: 9a20177b-d74b-5b8a-8e54-9d930b175c03

	/// Chiffre d'affaires hors taxes cumulé depuis le 1er janvier.
	measure 'CA HT cumul annuel' = TOTALYTD([CA HT], Calendrier[Date])
		formatString: #,0 €
		displayFolder: Chiffre d'affaires
		lineageTag: dee52732-d89c-52b6-954e-a767eda18be8

	/// Chiffre d'affaires hors taxes moins le coût d'achat des produits vendus.
	measure 'Marge HT' = SUM(Ventes[MargeHT])
		formatString: #,0 €
		displayFolder: Marge
		lineageTag: 635796be-51f2-573c-b03b-58069c5b4629

	/// Marge hors taxes rapportée au chiffre d'affaires hors taxes.
	measure 'Taux de marge' = DIVIDE([Marge HT], [CA HT])
		formatString: 0.0 %
		displayFolder: Marge
		lineageTag: 03b8b2d0-5c3b-5951-b01f-27f5941b3e6f

	/// Nombre de commandes distinctes non annulées.
	measure 'Nombre de commandes' = DISTINCTCOUNT(Ventes[Numéro de commande])
		formatString: #,0
		displayFolder: Commandes
		lineageTag: d24fa740-d964-5019-a9fd-7b5f0d86a18a

	/// Chiffre d'affaires hors taxes moyen par commande.
	measure 'Panier moyen HT' = DIVIDE([CA HT], [Nombre de commandes])
		formatString: #,0.00 €
		displayFolder: Commandes
		lineageTag: 628f31b8-db4a-5ac3-bd44-4a5e0258c928

	/// Nombre d'articles vendus.
	measure 'Quantité vendue' = SUM(Ventes[Quantite])
		formatString: #,0
		displayFolder: Commandes
		lineageTag: e8b35503-6658-5a3a-8f21-8b99e8aeb61d

	/// Nombre de clients distincts ayant passé au moins une commande sur la période.
	measure 'Nombre de clients acheteurs' = DISTINCTCOUNT(Ventes[ClientKey])
		formatString: #,0
		displayFolder: Commandes
		lineageTag: 84beb1b6-acc6-5bfb-87f2-a93e65b8ae71

	column DateCommandeId
		dataType: int64
		isHidden
		lineageTag: 2077b78b-beab-5811-af7d-f2ab9d3023f7
		sourceLineageTag: DateCommandeId
		summarizeBy: none
		sourceColumn: DateCommandeId

		annotation SummarizationSetBy = User

	column ClientKey
		dataType: int64
		isHidden
