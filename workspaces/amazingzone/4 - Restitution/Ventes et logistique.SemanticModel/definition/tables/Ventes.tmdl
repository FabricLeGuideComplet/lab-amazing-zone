		annotation SummarizationSetBy = User

	/// En attente, En cours ou Terminée.
	column 'Statut de commande'
		dataType: string
		lineageTag: cb656af5-1d9a-5d0a-9587-eec2511c7681
		sourceLineageTag: StatutCommande
		summarizeBy: none
		sourceColumn: StatutCommande

		annotation SummarizationSetBy = User

	/// Standard, Express ou Retrait, tel que choisi par le client.
	column 'Mode de livraison'
		dataType: string
		lineageTag: 04ef433c-a30d-541c-9494-0447266e155b
		sourceLineageTag: ModeLivraison
		summarizeBy: none
		sourceColumn: ModeLivraison

		annotation SummarizationSetBy = User

