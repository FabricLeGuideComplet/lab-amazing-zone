		annotation SummarizationSetBy = User

	/// Numéro de la commande, commun au site e-commerce et au WMS.
	column 'Numéro de commande'
		dataType: string
		lineageTag: a7a2ac52-4a09-5eeb-922a-ecace8afe52f
		sourceLineageTag: NumeroCommande
		summarizeBy: none
