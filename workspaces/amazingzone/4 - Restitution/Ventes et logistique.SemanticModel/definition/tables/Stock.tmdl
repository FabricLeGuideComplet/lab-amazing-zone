/// Photo quotidienne du stock par produit et par entrepôt. Le stock ne s'additionne pas dans le temps : les mesures retiennent le dernier jour de la période.
table Stock
	lineageTag: 75aa8b7b-8cbb-5353-b3ba-93a0131628f0
	sourceLineageTag: [gold].[FaitStockJour]

	/// Quantité en stock non réservée, au dernier jour photographié de la période.
	measure 'Stock disponible' = CALCULATE(SUM(Stock[QuantiteDisponible]), LASTNONBLANK(Calendrier[Date], CALCULATE(COUNTROWS(Stock))))
		formatString: #,0
		lineageTag: 8453722f-955c-589c-ad71-379d02e72b35

	/// Quantité physiquement en stock, au dernier jour photographié de la période.
	measure 'Stock physique' = CALCULATE(SUM(Stock[QuantiteStock]), LASTNONBLANK(Calendrier[Date], CALCULATE(COUNTROWS(Stock))))
		formatString: #,0
		lineageTag: 018cc0e0-606a-5798-a0c8-a35cd0905aa7

	column DateId
		dataType: int64
		isHidden
		lineageTag: 6ec98e63-1c8e-5784-bac1-50a9ae8f9bf3
		sourceLineageTag: DateId
		summarizeBy: none
		sourceColumn: DateId

		annotation SummarizationSetBy = User

	column ProduitKey
