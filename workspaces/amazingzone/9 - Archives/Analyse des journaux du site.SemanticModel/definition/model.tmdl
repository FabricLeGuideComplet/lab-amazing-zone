model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation ModelPopulated = value

annotation PBI_QueryOrder = ["Kusto Query Result"]

ref table 'Kusto Query Result'

